# Pinned runtime package versions for reproducible MCP startup.
# Source of truth: plugins/rldyour-mcps/.mcp.json
# Update intentionally after validating MCP capability smoke for the affected server.
#
# scripts/check_mcp_runtime_versions.py compares these pins against the live
# .mcp.json and surfaces any drift. CI dependency-check.yml runs the same
# check on a schedule and probes upstream registries for newer releases.

# Claude Code CLI pinned minimum version. Floor matches package.json CI pin.
# Covers all features used by this repo: Opus 4.8 via opus[1m] (v2.1.154+,
# account-gated) plus the v2.1.156 Opus 4.8 thinking-block API hotfix,
# alwaysLoad MCP option (v2.1.121+), claude plugin tag (v2.1.118+), hook `if` filter
# (v2.1.118+), maxSkillDescriptionChars/skillListingBudgetFraction (v2.1.105+),
# skillOverrides (v2.1.129+, plugin skills exempt), experimental.{themes,monitors} (v2.1.129+).
CLAUDE_CODE_MIN_VERSION=2.1.206

# Stdio MCP servers (uvx + bunx + system binaries).
SERENA_AGENT_VERSION=1.5.3
SEQUENTIAL_THINKING_MCP_VERSION=2026.7.4
# Bootstrap owns this transport: macos-ubuntu-bootstrap installs the wrapper at
# $HOME/.local/bin/chrome-devtools-mcp and its verifiers gate on exactly 1.6.0.
# This pin must track that contract; it read 1.5.0 while bootstrap installed
# 1.6.0, and nothing detected the drift because .mcp.json carries only the
# wrapper path, not a version literal.
CHROME_DEVTOOLS_MCP_VERSION=1.6.0
CONTEXT7_MCP_VERSION=3.2.3
SHADCN_VERSION=4.13.0

# Managed browser CLI outside MCP. The Webwright runtime is forbidden; the
# `webwright-task` skill name is compatibility routing only.
PLAYWRIGHT_CLI_VERSION=0.1.17


# HTTP MCP servers (no version pin - pinned by URL only).
DEEPWIKI_MCP_URL=https://mcp.deepwiki.com/mcp
GREP_MCP_URL=https://mcp.grep.app
FIGMA_MCP_URL=https://mcp.figma.com/mcp
OPENAI_DOCS_MCP_URL=https://developers.openai.com/mcp

# System binaries - pinned by host toolchain (Homebrew bottle / tracked SDK archive).
# Probed at runtime via `<binary> --version`; parity enforced by check_mcp_runtime_versions.py.
#   dart-flutter: requires `dart` on PATH; uses `dart mcp-server`. The MCP server
#                 ships inside the Dart SDK, so the pin is the Dart SDK version.
# Dart SDK 3.12.2 is provisioned by macos-ubuntu-bootstrap contract 2.3.0+:
# Ubuntu installs the tracked stable-channel SDK archive into a receipt-verified
# managed directory, macOS uses Homebrew `dart-sdk`, and both verifiers prove
# `dart mcp-server --version` responds. Before 2.3.0 no bootstrap path installed
# Dart on either platform and this server could never start.
#
# The `github` MCP server was removed by owner decision: it needed a
# `github-mcp-server` host binary that no bootstrap path installed on Ubuntu and a
# PAT that was never provisioned. Use the `gh` CLI, which bootstrap does install.
DART_SDK_VERSION=3.12.2
